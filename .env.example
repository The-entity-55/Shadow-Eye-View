# God's Eye View (Next.js) — Optional Provider Keys
# The app starts keyless with Esri World Imagery + Re:Earth terrain (OSM fallback),
# live adsb.lol / OpenSky flights, CelesTrak satellites, USGS earthquakes, and public CCTV.
# Copy to .env.local or configure via the in-app POWER UP -> Provider Settings modal.

# Client-exposed keys (restrict by HTTP referrer in provider consoles)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Server-side fallback / optional provider credentials
GOOGLE_MAPS_API_KEY=
CESIUM_ION_TOKEN=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
NASA_FIRMS_KEY=
AISSTREAM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
