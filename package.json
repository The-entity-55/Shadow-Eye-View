{
  "name": "gods-eye-nextjs",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js recreation of God's Eye View — real-time 3D geospatial intelligence console powered by CesiumJS, GLSL sensor shaders, and live OSINT feeds.",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/copy-cesium.mjs",
    "dev": "node scripts/copy-cesium.mjs && next dev --port 4173",
    "build": "node scripts/copy-cesium.mjs && next build",
    "start": "next start --port 4173",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "cesium": "1.138.0",
    "egm96-universal": "^1.1.1",
    "lucide-react": "^1.72.0",
    "mgrs": "^2.1.0",
    "next": "^16.4.6",
    "pbf": "^5.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satellite.js": "^6.0.2",
    "ws": "^8.22.2",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "@cesium/engine": "22.3.0",
    "@cesium/widgets": "14.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.0"
  }
}
